    "@mozilla/readability": "^0.6.0",
    "@types/diff-match-patch": "^1.0.36",
    "@types/dompurify": "^3.0.5",
    "@types/markdown-it": "^14.1.2",
    "@vueuse/components": "^14.2.0",
    "@vueuse/core": "^14.2.0",
    "a2a-js": "^0.2.0",
    "diff-match-patch": "^1.0.5",
    "dompurify": "^3.3.1",
    "element-plus": "2.13.0",
    "langchain": "^1.2.3",
    "localforage": "^1.10.0",
    "lucide-vue-next": "^0.562.0",
